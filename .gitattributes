* text=auto eol=lf

# TUI golden frames (spec 027): every row is padded to the terminal width, so trailing spaces are content.
src/test/resources/tui/golden/*.txt -whitespace

# Binary files - Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.bmp binary
*.tiff binary

# Binary files - Documents and Archives
*.pdf binary
*.jar binary
*.zip binary
*.tar.gz binary

# Binary files - Compiled code
*.class binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary