# syntax=docker/dockerfile:1.4
# Multi-stage Dockerfile for Fukuii Ethereum Client - Distroless Edition
# This version uses Google's distroless image for maximum security and minimal size

# Stage 1: Build stage using full JDK
FROM eclipse-temurin:25.0.5.1_2-jdk-noble AS builder

# Install required build tools including SBT
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        git \
        gnupg2 \
        ca-certificates \
        unzip \
    && curl -sL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x2EE0EA64E40A89B84B2DF73499E82A75642AC823" | gpg --dearmor -o /usr/share/keyrings/sbt-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/sbt-archive-keyring.gpg] https://repo.scala-sbt.org/scalasbt/debian all main" | tee /etc/apt/sources.list.d/sbt.list \
    && apt-get update \
    && apt-get install -y sbt

# Set up build environment
WORKDIR /build

# Create SBT cache directories with proper permissions
# Also set HOME explicitly to ensure SBT uses the correct paths
RUN mkdir -p /root/.cache/sbt /root/.ivy2 /root/.sbt && \
    chmod -R 755 /root/.cache /root/.ivy2 /root/.sbt
ENV HOME=/root
ENV SBT_OPTS="-Dsbt.global.base=/root/.sbt -Dsbt.ivy.home=/root/.ivy2 -Dsbt.boot.directory=/root/.sbt/boot"

# Copy dependency files first for better caching
COPY build.sbt version.sbt .jvmopts ./
COPY project/ ./project/

# Pre-download dependencies (cached layer)
RUN --mount=type=cache,target=/root/.ivy2 \
    --mount=type=cache,target=/root/.sbt \
    --mount=type=cache,target=/root/.cache \
    sbt update

# Copy source code
COPY . /build

# Build distribution
# Note: Submodules are already initialized by the GitHub Actions checkout step
# or should be initialized manually before building (git submodule update --init --recursive)
RUN --mount=type=cache,target=/root/.ivy2 \
    --mount=type=cache,target=/root/.sbt \
    --mount=type=cache,target=/root/.cache \
    sbt dist

# Extract the distribution zip
RUN cd target/universal && \
    DIST_FILE=$(ls fukuii-*.zip | head -1) && \
    unzip "$DIST_FILE" && \
    DIST_DIR=$(ls -d fukuii-*/ | head -1) && \
    mv "$DIST_DIR" /fukuii-dist

# Mount points for the runtime image. Distroless has no shell to mkdir them there, and a fresh volume at a path the
# image does not contain is created root-owned, which the nonroot user cannot write (the node creates <datadir>/tmp
# at startup). Copying them in with --chown gives fresh volumes nonroot ownership.
RUN mkdir -p /fukuii-volumes/data /fukuii-volumes/conf

# Stage 2: Runtime stage using distroless
FROM gcr.io/distroless/java25-debian13:nonroot

# OCI labels for container metadata
LABEL org.opencontainers.image.title="Fukuii Ethereum Client (Distroless)"
LABEL org.opencontainers.image.description="Fukuii - A Scala-based Ethereum Classic client (distroless)"
LABEL org.opencontainers.image.vendor="Chippr Robotics LLC"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.source="https://github.com/chippr-robotics/fukuii"
LABEL org.opencontainers.image.documentation="https://github.com/chippr-robotics/fukuii/blob/main/docs/deployment/docker.md"

# Copy application from builder (distroless already has nonroot user)
COPY --from=builder --chown=nonroot:nonroot /fukuii-dist /app/fukuii
COPY --from=builder --chown=nonroot:nonroot /fukuii-volumes/ /app/

# Set working directory
WORKDIR /app

# Set up environment
# Read by conf/base/fukuii.conf (datadir). A datadir in the conf the node runs still wins. With no arguments
# that is the bundled /app/fukuii/conf/etc.conf (see ENTRYPOINT), not /app/conf; pass a network argument
# (e.g. `etc`) to load a /app/conf/<network>.conf mounted in FUKUII_CONF_DIR (without one, the bundled conf
# is used). JSON-RPC stays on the container's loopback: a
# plaintext listener on 0.0.0.0 refuses the start unless it has tls.enabled or allow-insecure-bind (spec 030).
# To publish RPC, set FUKUII_RPC_INTERFACE=0.0.0.0 (read by network.conf) together with one of those in the conf.
ENV FUKUII_DATADIR=/app/data
# Not read by fukuii; kept for scripts that may reference it.
ENV FUKUII_DATA_DIR=/app/data
ENV FUKUII_CONF_DIR=/app/conf
# JDK-8385993: C2 ReduceAllocationMerges can silently miscompile field reads on
# JDK 23+ (fixed in JDK 28). JDK_JAVA_OPTIONS is read by every `java` launch in
# this container, including composes that override the entrypoint, and leaves
# JAVA_TOOL_OPTIONS free for operators. Side effect: java prints
# "NOTE: Picked up JDK_JAVA_OPTIONS: ..." on stderr at startup.
# CVE-2026-114938: the x86-64 Base64 decode intrinsic can be driven to memory
# corruption by crafted input. The pinned base image carries the fix; disabling
# the intrinsic also covers a host or image still on an affected JDK. Remove once
# no supported JDK predates 25.0.5.1 / 21.0.13.1.
# B-125: --sun-misc-unsafe-memory-access=allow stops JDK 24+ printing its
# sun.misc.Unsafe warning (Scala 3 lazy vals) over the TUI's first frame. This
# image's JDK is 25; JDK 22 and older would refuse the flag.
ENV JDK_JAVA_OPTIONS="-XX:+UnlockDiagnosticVMOptions -XX:-ReduceAllocationMerges -XX:DisableIntrinsic=_base64_decodeBlock --sun-misc-unsafe-memory-access=allow"

# Expose default ports (conf/base/network.conf)
# 8546: JSON-RPC HTTP (also /health, /readiness, /buildinfo)
# 8552: JSON-RPC WebSocket (off unless network.rpc.ws.enabled = true)
# 30303: P2P (TCP) and discovery (UDP)
EXPOSE 8546 8552 30303/tcp 30303/udp

# Configure volumes for persistent data
VOLUME ["/app/data", "/app/conf"]

# Note: Distroless images don't support HEALTHCHECK with shell scripts
# Health checks should be performed externally (e.g., by orchestration platform)
# For Kubernetes, use liveness/readiness probes with exec command checking process

# Set entrypoint to Java with the main class
# Distroless images don't have bash, so we must invoke Java directly
# The classpath includes all jars from the lib directory and the main application jar
# Uses etc.conf for Ethereum Classic mainnet by default
#
# JVM flags: `java` reads neither JAVA_OPTS nor the launcher's conf/application.ini, so the heap and memory
# envelope of src/universal/conf/application.ini (the other images' bin/fukuii applies it) is repeated here.
# Keep the two in step. The ReduceAllocationMerges and Base64 flags come from JDK_JAVA_OPTIONS above. These
# arguments follow JDK_JAVA_OPTIONS and JAVA_TOOL_OPTIONS, so they take precedence over both; to change the
# heap, override the entrypoint.
ENTRYPOINT ["java", \
    "-Xmx3g", \
    "-Xms1g", \
    "-Xss1M", \
    "-XX:MaxDirectMemorySize=512M", \
    "-XX:+UseG1GC", \
    "-XX:MaxGCPauseMillis=200", \
    "-XX:+HeapDumpOnOutOfMemoryError", \
    "-XX:HeapDumpPath=/app/data/logs/heapdump.hprof", \
    "-XX:+ExitOnOutOfMemoryError", \
    "-Dconfig.file=/app/fukuii/conf/etc.conf", \
    "-Dlogback.configurationFile=/app/fukuii/conf/logback.xml", \
    "-cp", "/app/fukuii/lib/*", \
    "com.chipprbots.ethereum.App"]
CMD []
